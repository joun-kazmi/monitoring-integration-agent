{
  "endpoints": [
    {
      "url": "/api/overview",
      "method": "GET",
      "auth": "basic",
      "auth_detail": "Default guest/guest, only usable from localhost",
      "response_format": "json",
      "notes": "Whole-system summary including message stats, queue totals, and object totals"
    },
    {
      "url": "/api/queues",
      "method": "GET",
      "auth": "basic",
      "auth_detail": "Default guest/guest, only usable from localhost",
      "response_format": "json",
      "notes": "List of all queues across all vhosts"
    },
    {
      "url": "/api/nodes",
      "method": "GET",
      "auth": "basic",
      "auth_detail": "Default guest/guest, only usable from localhost",
      "response_format": "json",
      "notes": "List of nodes in the cluster"
    }
  ],
