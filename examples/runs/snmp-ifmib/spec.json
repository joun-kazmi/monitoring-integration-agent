{
  "service": "netdev",
  "kind": "snmp_generator",
  "endpoints": [
    {
      "url": "snmp://target",
      "method": "GET",
      "auth": "none",
      "auth_detail": "",
      "response_format": "snmp",
      "notes": "snmp_exporter module=netdev, auth=public_v2"
    }
  ],
  "metrics": [
    {
      "name": "network_interface_receive_bytes_total",
      "type": "counter",
      "help": "Total octets received on the interface (64-bit counter).",
      "unit": "",
      "labels": [
        {
          "name": "ifIndex",
          "description": "table index ifIndex",
          "allowed_values": null,
          "required": true
        },
        {
          "name": "interface",
          "description": "lookup from ifName",
          "allowed_values": null,
          "required": true
        }
      ],
      "value": {
        "min": 0.0,
        "max": null
      },
      "source": "SNMP ifHCInOctets oid=1.3.6.1.2.1.31.1.1.1.6 module=IF-MIB",
      "required": true
    },
    {
      "name": "network_interface_transmit_bytes_total",
      "type": "counter",
      "help": "Total octets transmitted out of the interface (64-bit counter).",
