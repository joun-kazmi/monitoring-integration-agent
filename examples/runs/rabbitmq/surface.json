{
  "endpoints": [
    {
      "url": "/api/overview",
      "method": "GET",
      "auth": "basic",
      "auth_detail": "Default credentials guest/guest, usable only from localhost",
      "response_format": "json",
      "notes": "System-wide overview including message stats, queue totals, and object totals"
    },
    {
      "url": "/api/queues",
      "method": "GET",
      "auth": "basic",
      "auth_detail": "Default credentials guest/guest, usable only from localhost",
      "response_format": "json",
      "notes": "List of all queues across all vhosts"
    },
    {
      "url": "/api/nodes",
      "method": "GET",
      "auth": "basic",
      "auth_detail": "Default credentials guest/guest, usable only from localhost",
      "response_format": "json",
      "notes": "List of nodes in the cluster"
    }
  ],
  "fields": [
    {
      "endpoint_url": "/api/overview",
      "json_path": "$.message_stats.publish",
      "description": "Count of messages published",
      "suggested_kind": "counter",
      "labels_from": [
        "node"
      ]
    },
    {
      "endpoint_url": "/api/overview",
      "json_path": "$.message_stats.deliver_get",
      "description": "Count of messages delivered to consumers in ack mode plus basic.get",
      "suggested_kind": "counter",
      "labels_from": [
        "node"
      ]
    },
    {
      "endpoint_url": "/api/overview",
      "json_path": "$.message_stats.ack",
      "description": "Count of messages acknowledged",
      "suggested_kind": "counter",
      "labels_from": [
        "node"
      ]
    },
    {
      "endpoint_url": "/api/overview",
      "json_path": "$.message_stats.confirm",
      "description": "Count of messages confirmed",
      "suggested_kind": "counter",
      "labels_from": [
        "node"
      ]
    },
    {
      "endpoint_url": "/api/overview",
      "json_path": "$.queue_totals.messages",
      "description": "Total messages in all queues",
      "suggested_kind": "gauge",
      "labels_from": [
        "node"
      ]
    },
    {
      "endpoint_url": "/api/overview",
      "json_path": "$.queue_totals.messages_ready",
      "description": "Messages ready for delivery",
      "suggested_kind": "gauge",
      "labels_from": [
        "node"
      ]
    },
    {
      "endpoint_url": "/api/overview",
      "json_path": "$.queue_totals.messages_unacknowledged",
      "description": "Messages delivered but not yet acknowledged",
      "suggested_kind": "gauge",
      "labels_from": [
        "node"
      ]
    },
    {
      "endpoint_url": "/api/overview",
      "json_path": "$.object_totals.connections",
      "description": "Current count of connections",
      "suggested_kind": "gauge",
      "labels_from": [
        "node"
      ]
    },
    {
      "endpoint_url": "/api/overview",
      "json_path": "$.object_totals.channels",
      "description": "Current count of channels",
      "suggested_kind": "gauge",
      "labels_from": [
        "node"
      ]
    },
    {
      "endpoint_url": "/api/overview",
      "json_path": "$.object_totals.exchanges",
      "description": "Current count of exchanges",
      "suggested_kind": "gauge",
      "labels_from": [
        "node"
      ]
    },
    {
      "endpoint_url": "/api/overview",
      "json_path": "$.object_totals.queues",
      "description": "Current count of queues",
      "suggested_kind": "gauge",
      "labels_from": [
        "node"
      ]
    },
    {
      "endpoint_url": "/api/overview",
      "json_path": "$.object_totals.consumers",
      "description": "Current count of consumers",
      "suggested_kind": "gauge",
      "labels_from": [
        "node"
      ]
    },
    {
      "endpoint_url": "/api/queues",
      "json_path": "$[*].messages",
      "description": "Total message count in the queue",
      "suggested_kind": "gauge",
      "labels_from": [
        "name",
        "vhost",
        "state"
      ]
    },
    {
      "endpoint_url": "/api/queues",
      "json_path": "$[*].messages_ready",
      "description": "Messages ready for delivery in this queue",
      "suggested_kind": "gauge",
      "labels_from": [
        "name",
        "vhost",
        "state"
      ]
    },
    {
      "endpoint_url": "/api/queues",
      "json_path": "$[*].messages_unacknowledged",
      "description": "Messages delivered but awaiting ack in this queue",
      "suggested_kind": "gauge",
      "labels_from": [
        "name",
        "vhost",
        "state"
      ]
    },
    {
      "endpoint_url": "/api/queues",
      "json_path": "$[*].consumers",
      "description": "Number of consumers on this queue",
      "suggested_kind": "gauge",
      "labels_from": [
        "name",
        "vhost",
        "state"
      ]
    },
    {
      "endpoint_url": "/api/queues",
      "json_path": "$[*].memory",
      "description": "Bytes of memory used by the queue process",
      "suggested_kind": "gauge",
      "labels_from": [
        "name",
        "vhost",
        "state"
      ]
    },
    {
      "endpoint_url": "/api/queues",
      "json_path": "$[*].message_stats.publish",
      "description": "Messages published to this queue",
      "suggested_kind": "counter",
      "labels_from": [
        "name",
        "vhost",
        "state"
      ]
    },
    {
      "endpoint_url": "/api/nodes",
      "json_path": "$[*].mem_used",
      "description": "Bytes of memory used by the node",
      "suggested_kind": "gauge",
      "labels_from": [
        "name",
        "running"
      ]
    },
    {
      "endpoint_url": "/api/nodes",
      "json_path": "$[*].fd_used",
      "description": "File descriptors used by the node",
      "suggested_kind": "gauge",
      "labels_from": [
        "name",
        "running"
      ]
    },
    {
      "endpoint_url": "/api/nodes",
      "json_path": "$[*].fd_total",
      "description": "Total file descriptors available to the node",
      "suggested_kind": "gauge",
      "labels_from": [
        "name",
        "running"
      ]
    },
    {
      "endpoint_url": "/api/nodes",
      "json_path": "$[*].sockets_used",
      "description": "Sockets used by the node",
      "suggested_kind": "gauge",
      "labels_from": [
        "name",
        "running"
      ]
    },
    {
      "endpoint_url": "/api/nodes",
      "json_path": "$[*].sockets_total",
      "description": "Total sockets available to the node",
      "suggested_kind": "gauge",
      "labels_from": [
        "name",
        "running"
      ]
    },
    {
      "endpoint_url": "/api/nodes",
      "json_path": "$[*].proc_used",
      "description": "Erlang processes used by the node",
      "suggested_kind": "gauge",
      "labels_from": [
        "name",
        "running"
      ]
    },
    {
      "endpoint_url": "/api/nodes",
      "json_path": "$[*].proc_total",
      "description": "Total Erlang processes available to the node",
      "suggested_kind": "gauge",
      "labels_from": [
        "name",
        "running"
      ]
    },
    {
      "endpoint_url": "/api/nodes",
      "json_path": "$[*].uptime",
      "description": "Milliseconds since node start",
      "suggested_kind": "counter",
      "labels_from": [
        "name",
        "running"
      ]
    },
    {
      "endpoint_url": "/api/nodes",
      "json_path": "$[*].disk_free",
      "description": "Bytes of free disk space on the node",
      "suggested_kind": "gauge",
      "labels_from": [
        "name",
        "running"
      ]
    }
  ],
  "notes": "All endpoints share the same HTTP Basic auth against the RabbitMQ management plugin on port 15672 (paths given relative to that base URL since the docs don't specify a full base URL/host). /api/queues and /api/nodes return arrays, so json_path uses [*] to indicate per-element fields; labels_from lists identifying fields on each array element useful for label dimensions. uptime is technically a monotonically increasing value since node start (resets on restart) so it's marked as counter-like, though it could also be treated as a gauge depending on the metrics backend."
}