{
  "endpoints": [
    {
      "url": "/api/overview",
      "method": "GET",
      "auth": "basic",
      "auth_detail": "HTTP Basic authentication; default user guest / password guest (localhost only)",
      "response_format": "json",
      "notes": "System-wide overview: message stats, queue totals, object totals."
    },
    {
      "url": "/api/queues",
      "method": "GET",
      "auth": "basic",
      "auth_detail": "HTTP Basic authentication; default user guest / password guest (localhost only)",
      "response_format": "json",
      "notes": "JSON array of all queues across all vhosts; one element per queue."
    },
    {
      "url": "/api/nodes",
      "method": "GET",
      "auth": "basic",
      "auth_detail": "HTTP Basic authentication; default user guest / password guest (localhost only)",
      "response_format": "json",
      "notes": "JSON array of cluster nodes; one element per node."
    }
